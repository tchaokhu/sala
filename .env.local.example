# Copy to .env.local and fill from the Supabase project (ADR 0004).
# These two are safe in the browser — the anon key is limited by RLS, not kept
# secret. The service role key belongs only to the nightly job (ADR 0001) and
# must never appear here or in any request-handling code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
