# Copy to .env.local and fill from the Supabase project (ADR 0004).
# This file stays placeholders — it is tracked, .env.local is not.

# Safe in the browser: the anon key is limited by RLS, not kept secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Superadmin console (ADR 0006) ────────────────────────────────────────────
# Leave both blank and /admin refuses everyone, which is the safe default.
#
# The service role key BYPASSES EVERY ROW LEVEL SECURITY POLICY in the database.
# It is read in exactly one module, lib/supabase-admin.ts, and importable only
# from app/admin/ — tests/no-service-role-leak.test.ts fails the build otherwise.
# Never give it a NEXT_PUBLIC_ prefix: that inlines it into the browser bundle.
#
# Supabase → Project Settings → API Keys → Secret keys, the sb_secret_… value.
# This project uses the newer key system, where the publishable key above pairs
# with a secret key; on older projects the equivalent is the service_role JWT
# under Legacy API keys. Either works — the name of the variable is the concept,
# not the format.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated auth user ids (not emails) allowed into /admin. Adding or
# removing an operator is an environment change and a redeploy, deliberately —
# see ADR 0006. Find an id in Supabase → Authentication → Users.
SALA_SUPERADMIN_USER_IDS=
